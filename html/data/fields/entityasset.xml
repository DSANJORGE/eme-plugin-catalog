<?xml version="1.0" encoding="UTF-8"?>

<!-- Local dev: lets an entityasset (reference document) hang off a tutorial so the
     tutor RAG (AssistantManager.findDocIdsForEntity via the entitytutorialentityasset
     view) can find it. Merged with the plugin fields. -->
<properties>
  <property id="entitydepartment" index="true" datatype="list" editable="true" stored="true"
    viewtype="entity" internalfield="false" isbadge="false" rendertype="entity" required="false"
    multilanguage="false" highlight="false" autoincrement="false" aiautocreated="false">New <name>
      <language id="en"><![CDATA[Departments]]></language>
      <language id="de"><![CDATA[Abteilungen]]></language>
      <language id="fr"><![CDATA[Départements]]></language>
      <language id="es"><![CDATA[Departamentos]]></language>
    </name>
  </property>  
  <property id="pagescreatedfor"
    index="true" editable="true" stored="true" internalfield="false" isbadge="false"
    required="false" multilanguage="false" highlight="false" autoincrement="false"
    aiautocreated="false">New <name>
      <language id="en"><![CDATA[AssetID | Modtime]]></language>
      <language id="de"><![CDATA[AssetID | Modtime]]></language>
      <language id="fr"><![CDATA[ID de l'actif | Date de modification]]></language>
      <language id="es"><![CDATA[ID del activo | Hora de modificación]]></language>
    </name>
  </property>  
  <property id="regions" index="true"
    datatype="list" editable="true" stored="true" viewtype="entity" internalfield="false"
    isbadge="false" rendertype="entity" required="false" multilanguage="false" highlight="false"
    autoincrement="false" aiautocreated="false">New <name>
      <language id="en"><![CDATA[Regions]]></language>
      <language id="de"><![CDATA[Regionen]]></language>
      <language id="fr"><![CDATA[Régions]]></language>
      <language id="es"><![CDATA[Regiones]]></language>
    </name>
  </property>  
  <property id="formnumber" index="true"
    internalfield="false" editable="true" isbadge="false" required="false" multilanguage="false"
    highlight="false" autoincrement="false" stored="true" keyword="true" aiautocreated="false">New <name>
      <language id="en"><![CDATA[Form Number]]></language>
      <language id="de"><![CDATA[Formularnummer]]></language>
      <language id="fr"><![CDATA[Numéro de formulaire]]></language>
      <language id="es"><![CDATA[Número de formulario]]></language>
    </name>
  </property>  
  <property id="documenttype" index="true"
    stored="true" editable="true" type="list" listid="recordtype"
    rendermask="${data.primarymedia.recordtype.id||data.primaryimage.recordtype.id}">
    <name>
      <language id="en"><![CDATA[Document Type]]></language>
      <language id="de"><![CDATA[Dokumenttyp]]></language>
      <language id="fr"><![CDATA[Type de document]]></language>
      <language id="es"><![CDATA[Tipo de documento]]></language>
    </name>
  </property> &gt; <property id="librarycollection"
    index="true" filter="true" internalfield="false" deleted="false" datatype="list" editable="true"
    stored="true" viewtype="entity">New <name>
      <language id="en"><![CDATA[Project]]></language>
      <language id="de"><![CDATA[Projekt]]></language>
      <language id="fr"><![CDATA[Le projet]]></language>
      <language id="es"><![CDATA[Proyecto]]></language>
    </name>
  </property>  
  <property id="totalpages"
    datatype="number" viewtype="number" index="true" stored="true" searchcomponent="numbersearch"
    editable="true" type="number" rendermask="${data.primarymedia.pages}">
    <name>
      <language id="en"><![CDATA[Total Pages]]></language>
      <language id="de"><![CDATA[Gesamtseitenanzahl]]></language>
      <language id="fr"><![CDATA[Nombre de pages]]></language>
      <language id="es"><![CDATA[Total de páginas]]></language>
    </name>
  </property> 
  <property id="entitytutorial"
    index="true" stored="true" editable="true" type="list" viewtype="entity" listid="entitytutorial">
    <name>
      <language id="en">Tutorial</language>
      <language id="es">Tutorial</language>
    </name>
  </property>
  <property id="chapters"
    index="true" stored="true" editable="true" type="text">
    <name>
      <language id="en">Chapters / index (one per line: "m:ss Title" video, "p. N Title" PDF)</language>
      <language id="es">Capítulos / índice (uno por línea: "m:ss Título" video, "p. N Título" PDF)</language>
    </name>
  </property>
  <property
    id="credit" index="true" stored="true" editable="true" type="string">
    <name>
      <language id="en">Credit / attribution</language>
      <language id="es">Crédito / atribución</language>
    </name>
  </property>
</properties>